<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Wall.io.Views.Authorization">
  <Border 
      HorizontalAlignment="Center"
      VerticalAlignment="Center"
      BorderBrush="Orange"
      BorderThickness="2"
      > 
  

      <Grid RowDefinitions="Auto Auto Auto Auto Auto" HorizontalAlignment="Center" VerticalAlignment="Center">
      
            <TextBlock 
            x:Name="LogInSuccessState" 
            Text="Неверный логин или пароль" 
            HorizontalAlignment="Center" 
            Foreground="Red"
            IsVisible="False"
            Grid.Column="0"
            >
            </TextBlock>

            <TextBox 
                x:Name="LoginTextBox" 
                Watermark="Логин"
                Grid.Row="1"
            > 
            </TextBox>

            <TextBox 
                x:Name="PasswordTextBox" 
                Watermark="Пароль"
                Grid.Row="2"
            > 
            </TextBox>

            <Button 
                Content="Войти"
                x:Name="LogInButton"
                Grid.Row="3"
                HorizontalAlignment="Center"
                
            >
            </Button>

            <TextBlock 
                x:Name="ConnectionInfo" 
                HorizontalAlignment="Center"
                Grid.Row="4"
                Text="Нет подключения к серверу"
            > 
            </TextBlock>

      </Grid>
  
  </Border>
</UserControl>
